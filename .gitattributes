* text=auto

# Keep Linux deployment files executable-friendly after Windows checkouts.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf

# Native Windows helper scripts.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets and office templates.
*.jpg binary
*.png binary
*.webp binary
*.xlsx binary
