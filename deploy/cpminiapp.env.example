PORT=3000
DATA_DIR=/var/lib/cpminiapp/data
UPLOADS_DIR=/var/lib/cpminiapp/uploads
INVENTORY_REPORTS_DIR=/var/lib/cpminiapp/inventory-reports
ADMIN_PASSWORD=请设置独立的高强度管理密码
SESSION_SECRET=请设置至少32字节的随机字符串
# 拍图识别复核：百炼通义千问视觉模型，沿用下面的百炼密钥
IMAGE_RERANK_PROVIDER=dashscope
# qwen-vl-max 已于 2026-10-10 下线；qwen3.6-plus 在店里的测试图上最准
IMAGE_RERANK_MODEL=qwen3.6-plus
IMAGE_RERANK_CANDIDATES=8
IMAGE_RERANK_IMAGE_SIZE=640
# 复核时每个候选给哪张图：whole 整件衣服的图（默认）；best 和客户照片最像的图（常是详情页的局部特写）；both 两张都给
IMAGE_RERANK_PICTURES=whole
# 检索第一名领先第二名达到该值时不再复核（复核在这种情况下错得更多）
IMAGE_RERANK_SKIP_LEAD=0.03
# 改用其他 OpenAI 兼容接口时，去掉 IMAGE_RERANK_PROVIDER 并设置：
# IMAGE_RERANK_BASE_URL=https://your-compatible-api.example.com
# IMAGE_RERANK_API_KEY=请设置仅保存在服务器上的私有密钥
IMAGE_RERANK_TIMEOUT_MS=18000
IMAGE_RERANK_MAX_CONCURRENCY=4
VISUAL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
VISUAL_EMBEDDING_API_KEY=请设置仅保存在服务器上的阿里云百炼API密钥
VISUAL_EMBEDDING_MODEL=tongyi-embedding-vision-plus-2026-03-06
VISUAL_EMBEDDING_DIMENSIONS=1152
# 仓库实拍图的扣分（配合上面的模型调过；用 qwen3-vl-embedding 时为 0.03）
VISUAL_EMBEDDING_REAL_PHOTO_PENALTY=0.12
VISUAL_EMBEDDING_BATCH_SIZE=10
VISUAL_EMBEDDING_IMAGE_SIZE=448
VISUAL_EMBEDDING_TIMEOUT_MS=60000
# 拍图识别案例：保存部分真实识别（照片缩到 640 像素 + 当时的识别结果），用来改进识别。
# 没把握需要复核的都存，有把握的按比例抽样；最多条数、最长保留天数，超出先删最旧的。设为 off 不保存。
RECOGNITION_CASES=on
RECOGNITION_CASES_MAX=400
RECOGNITION_CASES_DAYS=60
RECOGNITION_CASES_SURE_SHARE=0.2
