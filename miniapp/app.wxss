page {
  background: #f6f4ef;
  color: #20201d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, image, button, input, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

button::after { border: 0; }

.page { min-height: 100vh; }
.surface { background: #ffffff; }
.muted { color: #8d8b84; }
.accent { color: #d99a21; }
.price { color: #df6148; font-weight: 700; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.page-navigation {
  position: relative;
  z-index: 20;
  width: 100%;
  flex-shrink: 0;
  background: #fffaf1;
  box-shadow: 0 8rpx 18rpx rgba(57, 48, 31, .045);
}

.page-navigation--sticky {
  position: sticky;
  top: 0;
  z-index: 50;
}

.page-navigation__bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 180rpx 14rpx;
}

.page-navigation__title {
  display: block;
  overflow: visible;
  color: #d5a13a;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 52rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(213, 161, 58, .1);
  white-space: nowrap;
}

.page-navigation__back {
  position: absolute;
  left: 16rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  transform: translateY(-50%);
}

.page-navigation__back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #d5a13a;
  border-bottom: 4rpx solid #d5a13a;
  transform: rotate(45deg);
}

.subpage-bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(54,48,37,.07);
  background: rgba(255,255,255,.97);
  box-shadow: 0 -12rpx 34rpx rgba(34,29,20,.09);
}

.subpage-home {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 88rpx;
  flex-shrink: 0;
  border: 1rpx solid #e9e4da;
  border-radius: 22rpx;
  background: #f8f6f2;
  color: #6f6a61;
  font-size: 19rpx;
}

.subpage-home image { width: 34rpx; height: 34rpx; margin-bottom: 5rpx; opacity: .82; }
.subpage-return {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  flex: 1;
  margin: 0;
  border-radius: 22rpx;
  background: #265b46;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin: 18rpx 24rpx;
  padding: 0 26rpx;
  border-radius: 38rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(65, 53, 30, .07);
}

.search-icon { margin-right: 16rpx; color: #9a978f; }
.search-input { flex: 1; font-size: 27rpx; }

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 26rpx 20rpx;
}
.section-title { font-size: 34rpx; font-weight: 800; }
.section-more { color: #9b978c; font-size: 24rpx; }

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: #f3eee3;
  color: #6d6558;
  font-size: 22rpx;
}
