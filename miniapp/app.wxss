/* Corner sizes shared by every page and section: three, plus pills and circles. Line icons are
   drawn in the bottom bar's style (assets/icons, scripts/generate-ui-icons.mjs). */
page {
  --radius-small: 8rpx;
  --radius-medium: 16rpx;
  --radius-large: 24rpx;
  --radius-pill: 999rpx;
}

page {
  background: #f6f4ef;
  color: #20201d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, image, button, input, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

button::after { border: 0; }

.page { min-height: 100vh; }
/* Pages whose navigation bar must not move: the content scrolls (and is pulled down to
   refresh) in a scroll-view below the bar. */
.page-shell { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.page-scroll { flex: 1; height: 0; }
/* 设计 and 我的 scroll in their own area inside the main page (pages/home/home). */
.section-scroll { height: 100%; }
/* The refresher moves the content with a transform on every touch move. On its own layer
   the content is just moved instead of repainted each frame (pages with many large
   pictures stuttered while being pulled). */
.page-scroll .page { min-height: 0; will-change: transform; }
.surface { background: #ffffff; }
.muted { color: #8d8b84; }
.accent { color: #d99a21; }
.price { color: #df6148; font-weight: 700; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
/* What anything that can be tapped shows while it is pressed (hover-class="is-pressed"). */
.is-pressed { opacity: .6; }
/* Room for the main page's bottom bar (components/tab-bar) under each of its sections. */
page { --tab-bar-space: calc(48px + env(safe-area-inset-bottom)); }
.tab-bar-space { padding-bottom: var(--tab-bar-space); }
.page-navigation {
  position: relative;
  z-index: 20;
  width: 100%;
  flex-shrink: 0;
  background: #fffaf1;
  box-shadow: 0 8rpx 18rpx rgba(57, 48, 31, .045);
}

.page-navigation--sticky {
  position: sticky;
  top: 0;
  z-index: 50;
}

.page-navigation__bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 180rpx 14rpx;
}

.page-navigation__title {
  display: block;
  overflow: visible;
  color: #d5a13a;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 52rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(213, 161, 58, .1);
  white-space: nowrap;
}

.page-navigation__back {
  position: absolute;
  left: 16rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  transform: translateY(-50%);
}

.page-navigation__back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #d5a13a;
  border-bottom: 4rpx solid #d5a13a;
  transform: rotate(45deg);
}

.subpage-bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(54,48,37,.07);
  background: rgba(255,255,255,.97);
  box-shadow: 0 -12rpx 34rpx rgba(34,29,20,.09);
}

.subpage-home {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 88rpx;
  flex-shrink: 0;
  border: 1rpx solid #e9e4da;
  border-radius: var(--radius-large);
  background: #f8f6f2;
  color: #6f6a61;
  font-size: 19rpx;
}

.subpage-home image { width: 34rpx; height: 34rpx; margin-bottom: 5rpx; opacity: .82; }
.subpage-return {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  flex: 1;
  margin: 0;
  border-radius: var(--radius-large);
  background: linear-gradient(105deg, #c98618, #e6ad32);
  box-shadow: 0 10rpx 24rpx rgba(198,132,22,.25);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin: 18rpx 24rpx;
  padding: 0 26rpx;
  border-radius: var(--radius-pill);
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(65, 53, 30, .07);
}

.search-icon { width: 32rpx; height: 32rpx; margin-right: 16rpx; flex-shrink: 0; }
.search-input { flex: 1; font-size: 27rpx; }

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 26rpx 20rpx;
}
.section-title { font-size: 34rpx; font-weight: 800; }
.section-more { display: flex; align-items: center; color: #9b978c; font-size: 24rpx; }

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: #f3eee3;
  color: #6d6558;
  font-size: 22rpx;
}
