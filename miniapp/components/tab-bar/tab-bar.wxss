/* Looks like WeChat's own bottom bar did. The height must stay in step with --tab-bar-space in
   app.wxss. */
.tab-bar { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; display: flex; height: calc(48px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: #ffffff; }
.tab-bar-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; }
.tab-bar-icon { display: block; width: 27px; height: 27px; }
.tab-bar-text { margin-top: 1px; color: #8a8a87; font-size: 10px; line-height: 13px; }
.tab-bar-text.selected { color: #d79a21; }
