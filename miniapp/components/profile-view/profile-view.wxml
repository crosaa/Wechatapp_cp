<scroll-view class="section-scroll" scroll-y="true">
  <view class="page-navigation" style="padding-top: {{pageNavigation.statusBarHeight}}rpx;">
    <view class="page-navigation__bar" style="height: {{pageNavigation.navigationBarHeight}}rpx;">
      <text class="page-navigation__title">我的</text>
    </view>
  </view>
  <view class="profile-page page tab-bar-space layout-{{settings.profileLayout}}">
    <view class="profile-hero">
      <stable-image wx:if="{{settings.storeIcon}}" class="profile-logo" src="{{settings.storeIcon}}" mode="aspectFill" />
      <view wx:else class="profile-mark">{{storeInitial}}</view>
      <view class="profile-copy">
        <view class="profile-store">{{settings.storeName}}</view>
        <view class="profile-name">{{settings.profileTitle}}</view>
        <view class="profile-desc">{{settings.profileSubtitle}}</view>
      </view>
    </view>

    <view class="profile-card surface">
      <view class="profile-card-title">{{settings.serviceTitle}}</view>
      <view class="service-grid">
        <view wx:for="{{serviceItems}}" wx:key="name"><image class="service-icon" src="{{item.icon}}" /><text>{{item.name}}</text></view>
      </view>
    </view>

    <view class="shop-card surface" wx:if="{{shopEntries.length}}">
      <view class="profile-card-title">购物服务</view>
      <view class="shop-entry" wx:for="{{shopEntries}}" wx:key="name" data-name="{{item.name}}" data-type="{{item.type}}" hover-class="is-pressed" bindtap="openShopEntry">
        <image class="shop-entry-icon" src="{{item.icon}}" />
        <text class="shop-entry-name">{{item.name}}</text>
        <image class="shop-entry-arrow" src="/assets/icons/chevron-right-faint.png" />
      </view>
    </view>

    <view class="about-card surface" wx:if="{{settings.aboutText}}">
      <view class="profile-card-title">{{settings.profileAboutTitle}}</view>
      <text>{{settings.aboutText}}</text>
    </view>

    <view class="profile-foot">{{settings.storeName}} · {{settings.footerText}}</view>
  </view>
</scroll-view>
