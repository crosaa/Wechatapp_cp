.home-page { padding-bottom: 28rpx; }
.home-first-frame { position: fixed; z-index: 15; top: 0; right: 0; bottom: 0; left: 0; padding-top: 128rpx; background: #f5f2eb; pointer-events: none; }
.home-first-brand { height: 126rpx; background: linear-gradient(145deg, #fffaf0, #f3e8cf); }
.home-first-search { height: 76rpx; margin: 18rpx 28rpx; border-radius: var(--radius-pill); background: #ece8df; }
.home-first-hero { height: 390rpx; background: #e9ddc8; }
.home-first-grid { height: 390rpx; margin: 22rpx 20rpx; border-radius: var(--radius-large); background: #fff; }
/* The navigation bar, brand rows and search box stay at the top; only the content below
   scrolls. Above the first-load placeholder (15). */
.home-header { position: relative; z-index: 50; flex-shrink: 0; }
.home-top {
  padding: 28rpx 0 12rpx;
  background: linear-gradient(145deg, #fffaf0, #f3e8cf);
}
.eyebrow { padding: 0 28rpx; color: #a57c32; font-size: 19rpx; letter-spacing: 5rpx; }
.brand-row { display: flex; align-items: flex-end; justify-content: space-between; padding: 12rpx 28rpx 8rpx; }
.home-brand-identity { display: flex; align-items: center; min-width: 0; }
.home-store-icon { width: 78rpx; height: 78rpx; margin-right: 16rpx; flex-shrink: 0; overflow: hidden; border-radius: var(--radius-medium); background: white; }
.brand-title { max-width: 430rpx; overflow: hidden; font-family: serif; font-size: 42rpx; font-weight: 800; letter-spacing: 2rpx; white-space: nowrap; text-overflow: ellipsis; }
.brand-sub { margin-top: 4rpx; color: #736a5b; font-size: 22rpx; letter-spacing: 3rpx; }
.home-search { margin-bottom: 0; }
.search-entry-placeholder { color: #9a978f; }
.camera-action { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 58rpx; margin-right: 10rpx; border-left: 1rpx solid #e4ddcf; }
.camera-action.recognizing { opacity: .45; }
.camera-icon { width: 38rpx; height: 38rpx; }
.search-action { color: #b17a16; font-size: 24rpx; font-weight: 700; }
.hero-wrap { position: relative; height: 390rpx; overflow: hidden; background: #e9ddc8; }
.hero-swiper { width: 100%; height: 100%; }
.hero { width: 100%; height: 100%; }
.hero-copy { position: absolute; left: 30rpx; top: 64rpx; bottom: 24rpx; width: 280rpx; }
.hero-note { position: absolute; left: 0; bottom: 0; display: inline-block; padding: 8rpx 14rpx; background: rgba(255,255,255,.78); color: #66553a; font-size: 21rpx; }
.hero-index { position: absolute; right: 24rpx; bottom: 20rpx; padding: 8rpx 14rpx; border-radius: var(--radius-pill); background: rgba(30,27,23,.55); color: white; font-size: 18rpx; }
.category-card { margin: 22rpx 20rpx 0; border-radius: var(--radius-large); box-shadow: 0 12rpx 40rpx rgba(62,48,24,.06); }
.section-en { margin-top: 4rpx; color: #b2ab9e; font-size: 18rpx; letter-spacing: 3rpx; }
.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); padding: 8rpx 8rpx 24rpx; }
.category-item { display: flex; flex-direction: column; align-items: center; padding: 16rpx 2rpx 22rpx; }
/* Every tile is the same: a square picture on the same light ground, a name of two lines at most. */
.category-icon { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; overflow: hidden; border-radius: var(--radius-large); background: #f2efe9; color: #8f8a81; font-size: 28rpx; font-weight: 900; }
.category-icon-image { display: block; width: 100%; height: 100%; border-radius: var(--radius-large); background: linear-gradient(135deg, #f2efe9, #e9e5dd); }
.category-icon-placeholder { border-color: transparent; background: #eeeae2; }
.category-name-placeholder { width: 96rpx; height: 26rpx; border-radius: var(--radius-pill); background: #eeeae2; }
.category-name { display: -webkit-box; width: 100%; max-width: 168rpx; margin-top: 15rpx; overflow: hidden; font-size: 24rpx; font-weight: 650; line-height: 32rpx; text-align: center; word-break: break-all; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.new-section { margin-top: 10rpx; }
.product-scroll { width: 100%; white-space: nowrap; }
.scroll-row { display: inline-flex; padding: 0 20rpx 26rpx; }
.home-product { width: 310rpx; margin-right: 18rpx; overflow: hidden; border-radius: var(--radius-medium); box-shadow: 0 10rpx 26rpx rgba(42,36,24,.06); }
.product-img-wrap { position: relative; width: 310rpx; height: 300rpx; overflow: hidden; background: #f0ede8; }
.home-product-img { width: 100%; height: 100%; }
.product-badge { position: absolute; left: 14rpx; top: 14rpx; padding: 6rpx 12rpx; border-radius: var(--radius-small); background: #d9a13b; color: #fff; font-size: 19rpx; }
.product-body { padding: 18rpx; }
.product-code { color: #a88342; font-size: 19rpx; letter-spacing: 2rpx; }
.product-name { height: 72rpx; margin-top: 6rpx; overflow: hidden; white-space: normal; font-weight: 700; line-height: 36rpx; }
.product-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.stock-text { color: #8f8a81; font-size: 18rpx; }
.stock-text.low { color: #b57613; font-weight: 700; }
.stock-text.out { color: #b84c42; font-weight: 700; }
.service-strip { display: flex; justify-content: space-around; margin: 2rpx 20rpx 0; padding: 22rpx 8rpx; border-top: 1rpx solid #e2ddd3; color: #766e60; font-size: 19rpx; }
.service-strip > view { display: flex; align-items: center; }
.service-check { width: 22rpx; height: 22rpx; margin-right: 6rpx; }
.section-more-icon { width: 24rpx; height: 24rpx; margin-left: 4rpx; }
