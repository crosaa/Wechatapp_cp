:host { display: block; }
.stable-image { position: relative; width: 100%; height: 100%; overflow: hidden; background: #f0ede6; }
.stable-image__placeholder { position: absolute; inset: 0; background: linear-gradient(135deg, #f2efe9, #e9e5dd); }
.stable-image__content { position: relative; z-index: 1; display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 90ms linear; }
.stable-image__previous { position: absolute; inset: 0; opacity: 1; transition: none; }
.stable-image.is-loaded .stable-image__content { opacity: 1; }
.stable-image.is-loaded .stable-image__previous { opacity: 1; }
.stable-image.is-failed .stable-image__placeholder { background: #eeeae3; }
