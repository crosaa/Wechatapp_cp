<view class="search-page-shell" capture-bind:touchstart="onPageTouch" capture-bind:touchend="onPageTouch" capture-bind:touchcancel="onPageTouch">
  <view class="page-navigation page-navigation--sticky" style="padding-top: {{pageNavigation.statusBarHeight}}rpx;">
    <view class="page-navigation__bar" style="height: {{pageNavigation.navigationBarHeight}}rpx;">
      <view class="page-navigation__back" bindtap="goBack" aria-label="返回">
        <view class="page-navigation__back-icon"></view>
      </view>
      <text class="page-navigation__title">商品搜索</text>
    </view>
  </view>

  <view class="search-page">
    <view class="search-workbench surface">
      <view class="search-box dedicated-search">
        <image class="search-icon" src="/assets/icons/search-muted.png" />
        <input
          class="search-input"
          value="{{keyword}}"
          focus="{{inputFocused}}"
          bindinput="onKeyword"
          bindconfirm="submitSearch"
          confirm-type="search"
          placeholder="输入款号、商品名称、品类或面料"
        />
        <view class="keyword-clear" wx:if="{{keyword}}" hover-class="is-pressed" bindtap="clearKeyword" aria-label="清空输入"><image src="/assets/icons/close-muted.png" /></view>
        <view class="search-submit" hover-class="is-pressed" bindtap="submitSearch">搜索</view>
      </view>
    </view>

    <view class="history-card surface">
      <view class="history-header">
        <view class="history-title">最近搜索</view>
        <view class="history-clear" wx:if="{{searchHistory.length}}" hover-class="is-pressed" bindtap="clearHistory">清空记录</view>
      </view>
      <view class="history-list" wx:if="{{searchHistory.length}}">
        <view class="history-item" wx:for="{{searchHistory}}" wx:key="*this" data-keyword="{{item}}" hover-class="is-pressed" bindtap="useSearchHistory">
          <image class="history-icon" src="/assets/icons/search-faint.png" />
          <text class="history-keyword">{{item}}</text>
          <image class="history-arrow" src="/assets/icons/chevron-right-faint.png" />
        </view>
      </view>
      <view class="history-empty" wx:else>还没有搜索记录</view>
    </view>
  </view>
</view>
