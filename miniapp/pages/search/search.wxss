.search-page-shell { min-height: 100vh; background: #f4f1eb; }
.search-page { padding: 20rpx 20rpx 40rpx; }
.search-workbench { padding: 18rpx 0 16rpx; border-radius: var(--radius-large); box-shadow: 0 10rpx 28rpx rgba(55,46,30,.06); }
.dedicated-search { height: 82rpx; margin: 0 18rpx; padding-right: 10rpx; background: #f5f3ef; box-shadow: none; }
.dedicated-search .search-input { height: 100%; }
.keyword-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #9b978f;
  font-size: 36rpx;
  line-height: 56rpx;
}
.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: #d99a21;
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
}
.history-card { margin-top: 18rpx; overflow: hidden; border-radius: var(--radius-large); box-shadow: 0 10rpx 28rpx rgba(55,46,30,.05); }
.history-header { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 28rpx 20rpx; border-bottom: 1rpx solid #eee9df; }
.history-title { color: #25241f; font-size: 29rpx; font-weight: 800; }
.history-clear { padding: 12rpx 0 12rpx 20rpx; color: #a87822; font-size: 22rpx; }
.history-list { padding: 0 28rpx; }
.history-item { display: flex; align-items: center; min-height: 82rpx; border-bottom: 1rpx solid #f0ece4; }
.history-item:last-child { border-bottom: 0; }
.keyword-clear image { width: 28rpx; height: 28rpx; }
.history-icon { width: 28rpx; height: 28rpx; margin-right: 17rpx; flex-shrink: 0; }
.history-keyword { flex: 1; overflow: hidden; color: #47443e; font-size: 25rpx; white-space: nowrap; text-overflow: ellipsis; }
.history-arrow { width: 26rpx; height: 26rpx; margin-left: 16rpx; flex-shrink: 0; }
.history-empty { padding: 86rpx 20rpx; color: #aaa49a; font-size: 23rpx; text-align: center; }
