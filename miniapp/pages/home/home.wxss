/* The sections lie on top of each other and only the active one is visible. The others stay laid
   out on this page, which never leaves the screen, so they can be reset while not showing and
   come back exactly as they are now (common/tabs.js). */
.tab-views { position: fixed; top: 0; right: 0; bottom: 0; left: 0; }
.tab-view { position: absolute; top: 0; right: 0; bottom: 0; left: 0; visibility: hidden; }
.tab-view--active { visibility: visible; }
