.designer-page {
  min-height: 100vh;
  padding-bottom: 110rpx;
  background: #efede8;
}

.designer-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 12rpx 20rpx;
  background: #2f302e;
  color: #fff;
}

.tool-left,
.tool-right {
  display: flex;
  align-items: center;
}

.tool-left { min-width: 0; }

.tool-pill {
  margin-right: 10rpx;
  padding: 9rpx 15rpx;
  border: 1rpx solid #777873;
  border-radius: 24rpx;
  font-size: 20rpx;
  white-space: nowrap;
}

.tool-pill.disabled { opacity: .38; }
.tool-text { margin-left: 16rpx; color: #f0b545; font-size: 23rpx; font-weight: 700; }

.tool-help {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: 14rpx;
  border: 1rpx solid #747570;
  border-radius: 50%;
  font-size: 22rpx;
}

.save-status {
  max-width: 124rpx;
  overflow: hidden;
  color: #aaa;
  font-size: 18rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.save-status.dirty { color: #f1b24c; }

.product-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78rpx;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid #e4e0d8;
  background: #fff;
}

.product-context-copy { min-width: 0; }
.product-context-copy > text { color: #a27c36; font-size: 18rpx; letter-spacing: 1rpx; }
.product-context-copy > view { overflow: hidden; max-width: 560rpx; margin-top: 3rpx; font-size: 23rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.source-state {
  max-width: 210rpx;
  overflow: hidden;
  padding: 7rpx 13rpx;
  border-radius: 18rpx;
  background: #f4efe4;
  color: #90723a;
  font-size: 18rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.design-stage {
  position: relative;
  height: 660rpx;
  overflow: hidden;
  background:
    linear-gradient(rgba(50, 48, 43, .035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(50, 48, 43, .035) 1rpx, transparent 1rpx),
    linear-gradient(155deg, #fff, #f5f1e9);
  background-size: 32rpx 32rpx, 32rpx 32rpx, auto;
}

.design-canvas {
  width: 100%;
  height: 100%;
}

.garment-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transform: scale(1.02);
}

.back-view {
  filter: saturate(.72) contrast(.94);
  transform: scale(1.02) rotateY(180deg);
}

.stage-tag,
.stage-tip {
  position: absolute;
  z-index: 6;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .9);
  color: #777168;
  font-size: 18rpx;
  pointer-events: none;
}

.stage-tag { left: 20rpx; top: 18rpx; padding: 8rpx 14rpx; }
.stage-tip { right: 18rpx; bottom: 18rpx; padding: 7rpx 13rpx; }

.movable-layer {
  z-index: 3;
  overflow: visible;
  border: 2rpx dashed transparent;
  box-sizing: border-box;
}

.movable-layer.selected {
  border-color: #d49a2d;
  background: rgba(255, 248, 232, .12);
}

.image-layer { width: 190rpx; height: 190rpx; }
.text-layer { width: 290rpx; height: 94rpx; }
.uploaded-overlay { width: 100%; height: 100%; }

.design-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  text-align: center;
  font-weight: 900;
  line-height: 1.15;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, .45);
  word-break: break-all;
}

.layer-label {
  position: absolute;
  right: -2rpx;
  top: -30rpx;
  display: none;
  padding: 3rpx 9rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #d49a2d;
  color: #fff;
  font-size: 16rpx;
}

.movable-layer.selected .layer-label { display: block; }

.face-row {
  display: flex;
  justify-content: center;
  border-top: 1rpx solid #eeeae2;
  background: #fff;
}

.face-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 190rpx;
  padding: 20rpx 0 16rpx;
  border-bottom: 5rpx solid transparent;
  color: #78746d;
}

.face-tab text { font-size: 25rpx; }
.face-tab .face-note { margin-top: 3rpx; color: #aaa59c; font-size: 16rpx; }
.face-tab.active { border-color: #d69b2c; color: #292824; font-weight: 800; }

.copy-face-action {
  display: flex;
  align-items: center;
  align-self: center;
  margin: 0 10rpx;
  padding: 9rpx 14rpx;
  border: 1rpx solid #e0d9cc;
  border-radius: 22rpx;
  color: #8d7549;
  font-size: 17rpx;
}

.copy-face-action text { margin-right: 5rpx; font-size: 24rpx; }

.base-image-section {
  padding: 17rpx 0 15rpx;
  border-top: 1rpx solid #eeeae2;
  background: #fff;
}

.base-image-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx 12rpx;
}

.base-image-head text:first-child { color: #34322e; font-size: 22rpx; font-weight: 800; }
.base-image-head text:last-child { color: #a29d94; font-size: 17rpx; }
.base-image-scroll { width: 100%; white-space: nowrap; }
.base-image-list { display: inline-flex; padding: 0 22rpx; }

.base-image-item {
  position: relative;
  width: 112rpx;
  margin-right: 12rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  border-radius: 13rpx;
  background: #f3f1ec;
  box-sizing: border-box;
}

.base-image-item.active {
  border-color: #d49a2d;
  box-shadow: 0 0 0 2rpx rgba(212, 154, 45, .16);
}

.base-image-thumb { display: block; width: 106rpx; height: 98rpx; background: #ece9e3; }
.base-image-item text {
  display: block;
  overflow: hidden;
  padding: 7rpx 5rpx 8rpx;
  color: #777168;
  font-size: 16rpx;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.base-image-item.active text { color: #9b6917; font-weight: 700; }

.product-color-row {
  width: 100%;
  border-top: 1rpx solid #eeebe5;
  background: #fff;
  white-space: nowrap;
}

.product-color-inner {
  display: inline-flex;
  align-items: center;
  min-width: 100%;
  padding: 17rpx 22rpx;
}

.control-title { margin-right: 17rpx; color: #716d65; font-size: 21rpx; }

.product-color-chip {
  margin-right: 12rpx;
  padding: 10rpx 17rpx;
  border: 1rpx solid #ddd8cf;
  border-radius: 22rpx;
  background: #f6f4ef;
  color: #68645d;
  font-size: 20rpx;
}

.product-color-chip.active {
  border-color: #c99029;
  background: #fff6e4;
  color: #986817;
  font-weight: 700;
}

.layer-control-card {
  margin-top: 14rpx;
  padding: 22rpx 24rpx 24rpx;
  background: #fff;
}

.layer-control-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #eeeae3;
}

.layer-control-head > view:first-child { display: flex; align-items: baseline; }
.layer-control-head > view:first-child text { margin-right: 12rpx; color: #99958c; font-size: 19rpx; }
.layer-control-head .current-layer-name { font-size: 25rpx; font-weight: 700; }
.layer-head-actions { display: flex; }
.layer-head-actions text { margin-left: 20rpx; color: #9a742c; font-size: 20rpx; }
.layer-head-actions text.danger { color: #b64d43; }

.control-row {
  display: grid;
  grid-template-columns: 64rpx 1fr 66rpx;
  align-items: center;
  min-height: 72rpx;
}

.control-row > text {
  color: #77736b;
  font-size: 20rpx;
}

.control-row > text:last-child {
  color: #393834;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.control-row slider { margin: 0 10rpx; }
.text-controls { border-top: 1rpx solid #f1eee8; }

.palette-scroll { width: 100%; white-space: nowrap; }
.palette-row { display: inline-flex; align-items: center; min-width: 100%; padding: 14rpx 0 4rpx; }
.palette-row > text { margin-right: 18rpx; color: #77736b; font-size: 20rpx; }

.color-dot {
  width: 40rpx;
  height: 40rpx;
  margin-right: 17rpx;
  border: 5rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx #cec9bf;
}

.color-dot.selected { box-shadow: 0 0 0 4rpx #d2a03f; }

.floating-panel {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: 100rpx;
  z-index: 30;
  padding: 20rpx;
  border: 1rpx solid #e6e0d5;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 12rpx 42rpx rgba(0, 0, 0, .2);
}

.floating-panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.floating-panel-title .panel-title-name { font-size: 24rpx; font-weight: 700; }
.floating-panel-title text { padding: 2rpx 10rpx; color: #999; font-size: 32rpx; }

.text-panel {
  display: grid;
  grid-template-columns: 1fr 150rpx;
}

.text-panel .floating-panel-title { grid-column: 1 / -1; }
.text-panel input { height: 70rpx; padding: 0 18rpx; border-radius: 10rpx; background: #f3f1ec; font-size: 23rpx; }
.text-panel button { height: 70rpx; margin-left: 12rpx; background: #d49a2d; color: #fff; font-size: 22rpx; line-height: 70rpx; }

.preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.preset-grid view {
  padding: 16rpx 8rpx;
  border: 1rpx solid #e7e1d7;
  border-radius: 12rpx;
  background: #f8f6f2;
  color: #55514a;
  font-size: 21rpx;
  text-align: center;
}

.designer-bottom {
  position: fixed;
  left: 50%;
  right: auto;
  bottom: 10rpx;
  z-index: 20;
  display: flex;
  width: 600rpx;
  min-height: 72rpx;
  padding: 5rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 19rpx;
  box-sizing: border-box;
  background: #242522;
  color: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, .12);
  transform: translateX(-50%);
}

.designer-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  font-size: 14rpx;
}

.designer-action > text { margin-bottom: 1rpx; font-size: 22rpx; font-weight: 800; }

.finish-button {
  flex: 1;
  min-height: 62rpx;
  margin: 0;
  border-radius: 15rpx;
  background: linear-gradient(135deg, #d7a03a, #bd791d);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.finish-button text { margin-right: 8rpx; }
